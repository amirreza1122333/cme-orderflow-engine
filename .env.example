# Copy to .env and fill in. NEVER commit the real .env.
#
# PLATFORM: CME futures through Sierra Chart's DTC server (migrated 2026-08-21
# from the cTrader Open API). Sierra Chart is already logged in to your broker,
# so this file holds almost no secrets - the DTC server is a local process and
# usually needs no credentials at all.
#
# Every value here has a working default in config.py. The engine starts on the
# dry feed with no .env whatsoever.

# --- Sierra Chart DTC server ---
# Enable it in Sierra Chart:
#   File > Global Settings > Data/Trade Service Settings > DTC Protocol Server
#   Listening Port 11099, Encoding: Binary, Allow Trading: yes
DTC_HOST=localhost
DTC_PORT=11099

# Only if you set "Require Authentication" on the DTC server. Usually blank.
DTC_USERNAME=
DTC_PASSWORD=

# The broker account Sierra Chart should route orders to. Leave blank to use
# whatever account the DTC logon returns as default.
DTC_TRADE_ACCOUNT=

# paper | live - whether orders may leave this machine.
# Live orders additionally require --arm, --i-understand-live and a typed
# confirmation. Leave this on "paper" until you have a proven sample.
#
# NOTE: the live order path is NOT implemented yet - core/dtc_client.py is a
# placeholder - so "live" currently means "refuse every order and say so".
EXECUTION_MODE=paper

# --- Engine ---
AUTOTRADE_DEFAULT=false
DEFAULT_SYMBOL=MGC
BAR_SECONDS=300

# Simulated starting balance for paper mode. Set it to the capital you
# actually intend to trade, or paper drawdowns will not be to scale.
PAPER_START_BALANCE=500

# Round-turn commission per CONTRACT, in account currency, from your broker's
# schedule. MGC is typically $1.00-$1.50 all-in. Leaving it at 0 flatters
# paper results.
COMMISSION_PER_CONTRACT=0.00

# --- Risk envelope ---
# READ THIS BEFORE CHANGING. A futures position is a whole number of contracts
# and the floor is 1 - the engine cannot size below it. One MGC contract at the
# configured 4.30 stop risks $43. So RISK_PER_TRADE below 43 means every trade
# is refused, and 43 on a $500 account is 8.6% per trade, which is far outside
# any sustainable envelope.
#
# These defaults exist so PAPER trading and data collection can run. They are
# not a live risk envelope for a $500 account. Either fund the account to the
# point where $43 is ~1-2% (about $2,000-$4,000), or keep EXECUTION_MODE=paper.
RISK_PER_TRADE=50
MAX_DAILY_LOSS=100
MAX_DAILY_PROFIT=100
MAX_DAILY_TRADES=6

# --- Strategy ---
# ema | ict
STRATEGY_MODE=ict
# true = no trades until a trained model exists (the specification's rule).
# false = run the eight ICT conditions alone while data collects.
ICT_REQUIRE_MODEL=true

# --- Optional ---
# Enables the Claude review layer. Without it the engine runs on technicals,
# order book and the news filter alone.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Bearer token for the monitoring panel. Only required when binding the panel
# to a non-local interface; generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
PANEL_TOKEN=
